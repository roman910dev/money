{
	"name": "money",
	"version": "1.0.0",
	"description": "Personal money tracking cli tool using SQLite, Drizzle and CommanderJS.",
	"author": "Román Via-Dufresne Saus <roman910dev@gmail.com>(https://github.com/roman910dev)",
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"postbuild": "tsc-alias -p tsconfig.build.json && chmod +x money/index.js",
		"check": "biome check .",
		"fix": "biome check . --write",
		"format": "biome format . --write",
		"full-check": "pnpm ts && pnpm check",
		"lint": "biome lint .",
		"test": "echo \"Error: no test specified\" && exit 1",
		"ts": "tsc --noEmit"
	},
	"keywords": [],
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@types/lodash": "^4.17.20",
		"@types/node": "^24.7.0",
		"drizzle-kit": "^0.31.5",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.1.0",
		"@libsql/client": "^0.15.15",
		"chalk": "^5.6.2",
		"cli-table3": "^0.6.5",
		"commander": "^14.0.1",
		"drizzle-orm": "^0.45.1",
		"fuse.js": "^7.1.0",
		"lodash": "^4.17.21",
		"zod": "^4.3.5",
		"zod-commander": "^0.1.0"
	},
	"bin": {
		"money": "./money/index.js"
	}
}
